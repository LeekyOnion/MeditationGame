[resource]
resource_local_to_scene = true
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float refraction_str = 0.10000000149012;
uniform sampler2D sand;
uniform sampler2D screen_tex_frg_10 : hint_screen_texture;
uniform vec4 ColorParameter : source_color = vec4(0.000000, 0.000000, 1.000000, 0.835294);
uniform vec4 ColorParameter2 : source_color = vec4(0.000000, 1.000000, 1.000000, 0.568627);



void fragment() {
// FloatParameter:13
	float n_out13p0 = refraction_str;


	vec3 n_out6p0;
// Expression:6
	n_out6p0 = vec3(0.0, 0.0, 0.0);
	{
		vec3 duv = vec3(4.0 / 512.0, 4.0 / 512.0, 0);
		float v1 = texture(sand, UV - duv.xz).y;
		float v2 = texture(sand, UV + duv.xz).y;
		float v3 = texture(sand, UV - duv.zy).y;
		float v4 = texture(sand, UV + duv.zy).y;
		
		n_out6p0 = normalize(vec3(v1 - v2, v3 - v4, 0.3));
	}


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out13p0) * n_out6p0;


// Input:9
	vec2 n_out9p0 = SCREEN_UV;


// VectorOp:8
	vec3 n_out8p0 = n_out7p0 + vec3(n_out9p0, 0.0);


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(screen_tex_frg_10, vec2(n_out8p0.xy));


// ColorParameter:16
	vec4 n_out16p0 = ColorParameter;


// ColorParameter:17
	vec4 n_out17p0 = ColorParameter2;


// Mix:18
	vec3 n_in18p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out18p0 = mix(vec3(n_out16p0.xyz), vec3(n_out17p0.xyz), n_in18p2);


// Mix:5
	vec3 n_in5p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_in5p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out5p0 = mix(n_out18p0, n_in5p1, n_in5p2);


// FloatConstant:12
	float n_out12p0 = 0.800000;


// Mix:11
	vec3 n_out11p0 = mix(vec3(n_out10p0.xyz), n_out5p0, vec3(n_out12p0));


// Output:0
	ALBEDO = n_out11p0;
	NORMAL = n_out6p0;


}
