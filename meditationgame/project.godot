; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MeditationGame"
run/main_scene="res://02_Scenes/Main Menu/main_menu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
config/icon="res://05_Testing/icon.svg"

[autoload]

Globals="*res://04_Global Scripts/Global Scripts/globals.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/light_projectors/filter=0
gdscript/decals/filter=0
gdscript/positional_shadow/atlas_size.mobile=1024
gdscript/positional_shadow/atlas_size=2048
gdscript/directional_shadow/size.mobile=1024
gdscript/directional_shadow/size=2048
gdscript/shadow_atlas/size=1024
gdscript/max_fps=60
gdscript/canvas_textures/default_texture_filter=0

[global_group]

"Raycast Surfaces"="Used to check for objects that only qualify as being raycastable from the draw/placement functions"

[importer_defaults]

animation_library={
"animation/fps": 60.0
}

